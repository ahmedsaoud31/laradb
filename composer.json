{
    "name": "ahmedsaoud31/laradb",
    "description": "Backup and Restore data from active database and skip deleted rows in restore",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmed Saoud",
            "email": "ahmedsaoud31@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Laradb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laradb\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laradb\\LaradbServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}